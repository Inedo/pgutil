<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PgUtil</RootNamespace>
    <Description>CLI for ProGet's APIs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>0.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inedo.ProGet\Inedo.ProGet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="/" />
    <PackageReference Include="Inedo.ConsoleMan" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <TrimmerRootAssembly Include="pgutil" />
  </ItemGroup>
</Project>